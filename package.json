{
  "name": "firebirdrest-js",
  "version": "0.2.0",
  "description": "JavaScript/TypeScript client for FirebirdREST with the supabase-js query API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariuz/firebirdrest-js.git"
  },
  "homepage": "https://github.com/mariuz/firebirdrest-js#readme",
  "bugs": "https://github.com/mariuz/firebirdrest-js/issues",
  "keywords": [
    "firebird",
    "firebirdrest",
    "postgrest",
    "supabase",
    "rest",
    "client",
    "database"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./gen": {
      "types": "./dist/gen.d.ts",
      "import": "./dist/gen.js",
      "require": "./dist/gen.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@supabase/postgrest-js": "^2.118.0"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "@types/node": "^22.0.0"
  },
  "bin": {
    "firebirdrest-js": "./dist/cli.js"
  }
}
